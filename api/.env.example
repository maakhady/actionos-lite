# Base PostgreSQL démarrée par `docker compose up -d` (voir docker-compose.yml à la racine).
# Le port 5433 est volontaire : 5432 est souvent déjà occupé par un PostgreSQL local.
DATABASE_URL="postgresql://actionos:actionos@localhost:5433/actionos?schema=public"

PORT=3000

# Optionnelle : active l'extracteur IA (Claude Haiku 4.5) en complément des
# règles, avec repli automatique sur les règles si absente ou en cas d'échec.
# ANTHROPIC_API_KEY=
